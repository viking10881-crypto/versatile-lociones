# Conexión con Delasoft (las mismas variables que usa shop-tecnology).
# La clave se genera en el admin de Delasoft (delasoft_front) y solo vive en el servidor:
# nunca se envía al navegador. Sin ella, la tienda muestra productos de ejemplo.
DELASOFT_PUBLIC_API_URL=https://delasoft-back.onrender.com/public-api/v1
DELASOFT_PUBLIC_API_KEY=ak_tu_clave_de_delasoft
# Debe coincidir con uno de los "orígenes permitidos" de la clave en el admin.
DELASOFT_STORE_ORIGIN=https://versatille-lociones-delasoft.vercel.app
